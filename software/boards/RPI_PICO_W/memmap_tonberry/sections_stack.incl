SECTIONS
{
    /* .stack*_dummy section doesn't contains any symbols. It is only
     * used for linker to calculate size of stack sections, and assign
     * values to stack symbols later
     *
     * stack1 section may be empty/missing if platform_launch_core1 is not used */

    /* Tonberry change vs. the pico-sdk default: memmap_mp_rp2.ld merges the
     * scratch banks (SCRATCH_X_LENGTH = 0), so SCRATCH_X cannot hold the core1
     * stack. Place .stack1_dummy at the bottom of the merged SCRATCH_Y instead;
     * section_extra_post_end.incl re-assigns __StackOneTop/__StackOneBottom.
     */
    .stack1_dummy (NOLOAD):
    {
        *(.stack1*)
    } > SCRATCH_Y
    .stack_dummy (NOLOAD):
    {
        KEEP(*(.stack*))
    } > SCRATCH_Y
}
